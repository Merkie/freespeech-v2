{
	"permissions": {
		"allow": ["Read", "Edit", "Write", "Glob", "Grep", "Bash(npm:*)", "Bash(git:*)", "Bash(npx prettier:*)"],
		"deny": ["Bash(rm -rf:*)", "Bash(sudo:*)"]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "npx prettier --write $CLAUDE_FILE_PATHS 2>/dev/null || true"
					}
				]
			}
		]
	}
}
