generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  Project               Project[]
  projectCollaborations ProjectCollaborator[]

  email                    String  @unique
  name                     String
  password                 String?
  profileImgUrl            String?
  elevenLabsApiKey         String?
  usePersonalElevenLabsKey Boolean @default(false)

  // Account-level editing guard. The verifier is returned only from the authenticated
  // access-controls endpoint so clients can cache it for offline use.
  editPinEnabled   Boolean  @default(false)
  editPinMode      String   @default("pin")
  editPinHash      String?
  editPinSalt      String?
  editPinUpdatedAt DateTime @default(now())

  // Account-level opt-in. Disabling it pauses every invitation and accepted
  // collaborator's access without deleting the per-board collaborator list.
  collaborationEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  collaborators ProjectCollaborator[]

  name        String
  description String?
  imageUrl    String?
  columns     Int     @default(6)
  rows        Int     @default(4)
  isPublic    Boolean @default(false)
  isFavorite  Boolean @default(false)
  homePageId  String?

  // Full project blob (all pages, tiles, templates) stored as JSON
  blob Json @default("{\"name\":\"\",\"description\":null,\"imageUrl\":null,\"columns\":6,\"rows\":4,\"homePageId\":null,\"pages\":[]}")

  // For cache invalidation - updated when any tile/page in project changes
  lastEditedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProjectCollaborationStatus {
  PENDING
  ACCEPTED
}

model ProjectCollaborator {
  id String @id @default(cuid())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  status      ProjectCollaborationStatus @default(PENDING)
  isFavorite  Boolean                    @default(false)
  invitedAt   DateTime                   @default(now())
  respondedAt DateTime?

  @@unique([projectId, userId])
  @@index([userId, status])
}
